PORT=3000

MONGODB_URI=mongodb://127.0.0.1:27017/ARfusion?replicaSet=rs0

CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Use different long random secrets for each role.
CUSTOMER_JWT_SECRET=
ADMIN_JWT_SECRET=

# Google OAuth web client ID (same client ID configured in the frontend)
GOOGLE_CLIENT_ID=

# Razorpay Test Mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NODE_ENV=development

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="ARFusion Commerce <your-email@gmail.com>"
